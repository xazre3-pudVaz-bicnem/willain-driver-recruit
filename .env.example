# ============================================
# 株式会社ウィラン 採用サイト 環境変数
# ============================================

# --- サイトURL ---
# 通常は未設定でOK（本番ビルドは自動で https://www.willain.jp を使用）。
# ステージング等で上書きする場合のみ設定（末尾スラッシュなし）。
NEXT_PUBLIC_SITE_URL=
# 旧Vercelドメインを正式ドメインへ301したい場合にホスト名を設定
# 例: willain-driver-recruit.vercel.app
LEGACY_VERCEL_HOST=

# --- 応募フォーム（Resend）---
# https://resend.com でAPIキーを発行
RESEND_API_KEY=
# 応募通知の送信先メールアドレス（採用担当者）
APPLICATION_TO_EMAIL=
# 送信元メールアドレス（Resendで認証済みドメインのアドレス）
APPLICATION_FROM_EMAIL=

# --- Google Search Console 所有権確認 ---
# <meta name="google-site-verification"> の content 値
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Bing Webmaster Tools 所有権確認 ---
# <meta name="msvalidate.01"> の content 値
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- アクセス解析（どちらか一方、または両方）---
# GA4 測定ID（例: G-XXXXXXXXXX）
NEXT_PUBLIC_GA_ID=
# Google Tag Manager ID（例: GTM-XXXXXXX）
NEXT_PUBLIC_GTM_ID=

# --- Google Indexing API（任意実行スクリプト用）---
# Google Cloudのサービスアカウントの client_email
GOOGLE_INDEXING_CLIENT_EMAIL=
# サービスアカウントの秘密鍵（改行は \n のままでOK）
GOOGLE_INDEXING_PRIVATE_KEY=

# ============================================
# 採用コラム自動投稿（Claude Haiku + GitHub Actions）
# 詳細は AUTO_COLUMN_SETUP.md を参照
# ============================================

# --- Anthropic API ---
# https://console.anthropic.com で発行（GitHub Secretsに登録・コードに直書きしない）
ANTHROPIC_API_KEY=
# 使用モデル（未設定なら claude-haiku-4-5-20251001）。記事生成にSonnet/Opus/Fableは使わない
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- 自動投稿の制御（未設定でも安全なデフォルトで動作）---
# false にすると APIを呼ばず正常終了（自動投稿の一時停止）
AUTO_COLUMN_ENABLED=true
# 1日の最大投稿数（既定1）
AUTO_COLUMN_MAX_PER_DAY=1
# 本文の最小・最大文字数（既定 2500 / 4500）
AUTO_COLUMN_MIN_LENGTH=2500
AUTO_COLUMN_MAX_LENGTH=4500
