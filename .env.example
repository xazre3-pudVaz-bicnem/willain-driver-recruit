# ============================================
# 株式会社ウィラン 採用サイト 環境変数
# ============================================

# --- サイトURL（公開時に必ず設定）---
# 例: https://recruit.willain.jp （末尾スラッシュなし）
NEXT_PUBLIC_SITE_URL=

# --- 応募フォーム（Resend）---
# https://resend.com でAPIキーを発行
RESEND_API_KEY=
# 応募通知の送信先メールアドレス（採用担当者）
APPLICATION_TO_EMAIL=
# 送信元メールアドレス（Resendで認証済みドメインのアドレス）
APPLICATION_FROM_EMAIL=

# --- Google Search Console 所有権確認 ---
# <meta name="google-site-verification"> の content 値
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- アクセス解析（どちらか一方、または両方）---
# GA4 測定ID（例: G-XXXXXXXXXX）
NEXT_PUBLIC_GA_ID=
# Google Tag Manager ID（例: GTM-XXXXXXX）
NEXT_PUBLIC_GTM_ID=

# --- Google Indexing API（任意実行スクリプト用）---
# Google Cloudのサービスアカウントの client_email
GOOGLE_INDEXING_CLIENT_EMAIL=
# サービスアカウントの秘密鍵（改行は \n のままでOK）
GOOGLE_INDEXING_PRIVATE_KEY=
